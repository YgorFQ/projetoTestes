  "html": "<div class=\"lp-container\">\n    <!-- ---------------------------------------- ÁREA PARA COLOCAR STYLES ----------------------------------------------------------- -->\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        .lp-container {\n            width: 100%;\n            background-color: #ffffff;\n            color: #0a1838;\n        }\n\n        .pdp {\n            width: 100%;\n            max-width: 1600px;\n            margin: 0 auto;\n            overflow: hidden;\n            background-color: #ffffff;\n        }\n\n        .product-header-2 {\n            --badge-size: 112px;\n            --banner-height: 145px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            width: 100%;\n            position: relative;\n            background-color: #ffffff;\n        }\n\n        .product-header__banner-2 {\n            width: 100%;\n            height: var(--banner-height);\n            position: relative;\n            display: flex;\n            justify-content: center;\n            overflow: visible;\n            background-color: #07183a;\n        }\n\n\n        .product-header__figure-2 {\n            width: 100%;\n            height: 100%;\n            margin: 0;\n            position: absolute;\n            inset: 0;\n            overflow: hidden;\n        }\n\n        .product-header__banner-img-2 {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            opacity: 0;\n        }\n\n        .product-header__badge-2 {\n            position: absolute;\n            left: 50%;\n            bottom: calc(var(--badge-size) / -2 + 2px);\n            transform: translateX(-50%);\n            width: var(--badge-size);\n            height: var(--badge-size);\n            background-color: #ff9900;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            overflow: hidden;\n            z-index: 10;\n        }\n\n        .product-header__badge-img-2 {\n            width: 76%;\n            height: 76%;\n            max-width: 86px;\n            max-height: 86px;\n            object-fit: contain;\n        }\n\n        .product-header__body-2 {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            width: 100%;\n            padding: 55px 24px 24px;\n            text-align: center;\n            background-color: #ffffff;\n        }\n\n        .product-header__brand-2 {\n            color: #f39a18;\n            font-size: 0.72rem;\n            font-weight: 700;\n            letter-spacing: 0.22em;\n            text-transform: uppercase;\n            margin-bottom: 0.45rem;\n        }\n\n        .product-header__title-2 {\n            max-width: 900px;\n            color: #0a1838;\n            font-size: clamp(1.85rem, 3.25vw, 2.9rem);\n            font-weight: 400;\n            line-height: 1.04;\n            letter-spacing: -0.02em;\n            text-wrap: balance;\n        }\n\n        .product-header__title-line-2 {\n            display: block;\n            font-weight: 400;\n        }\n\n        .product-header__title-strong-2 {\n            display: block;\n            font-weight: 700;\n        }\n\n        .product-header__accent-2 {\n            width: 36px;\n            height: 2px;\n            margin-top: 1.15rem;\n            border-radius: 999px;\n            background-color: #f39a18;\n        }\n\n        .product-header__subtitle-2 {\n            max-width: 620px;\n            margin-top: 1rem;\n            color: #707070;\n            font-size: clamp(0.98rem, 1.8vw, 1.12rem);\n            line-height: 1.45;\n            text-wrap: pretty;\n        }\n\n        .section-15-container {\n            width: 100%;\n            padding: 0 2rem;\n            background-color: #ffffff;\n        }\n\n        .section-15 {\n            display: flex;\n            width: 100%;\n            max-width: 1220px;\n            min-height: 318px;\n            margin: 0 auto;\n            overflow: hidden;\n            border-radius: 24px;\n            background-color: #07183a;\n        }\n\n        .is-reverse {\n            flex-direction: row-reverse;\n        }\n\n        .section-15__image-wrapper {\n            flex: 0 0 52%;\n            width: 52%;\n            min-height: 318px;\n            overflow: hidden;\n            background-color: #e9e5dd;\n        }\n\n        .section-15__image {\n            display: block;\n            width: 100%;\n            height: 100%;\n            min-height: 318px;\n            object-fit: cover;\n        }\n\n        .section-15__content {\n            display: flex;\n            flex: 1 1 48%;\n            flex-direction: column;\n            justify-content: center;\n            min-width: 0;\n            padding: clamp(2rem, 4vw, 4.15rem);\n        }\n\n        .section-15__title {\n            max-width: 460px;\n            margin: 0;\n            color: #ffffff;\n            font-size: clamp(1.8rem, 3vw, 2.55rem);\n            font-weight: 700;\n            line-height: 1.13;\n            letter-spacing: -0.02em;\n        }\n\n        .section-15__title::after {\n            content: \"\";\n            display: block;\n            width: 36px;\n            height: 2px;\n            margin-top: 1.15rem;\n            border-radius: 999px;\n            background-color: #f39a18;\n        }\n\n        .section-15__desc {\n            max-width: 480px;\n            margin: 1.15rem 0 0;\n            color: #f2f4f8;\n            font-size: clamp(0.93rem, 1.5vw, 1.08rem);\n            line-height: 1.55;\n        }\n\n        .section-15__feature-list {\n            display: flex;\n            flex-direction: column;\n            width: 100%;\n            padding: 0;\n            margin: 0;\n            list-style: none;\n        }\n\n        .section-15__feature-item {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n            width: 100%;\n            padding: 1.15rem 0;\n            border-bottom: 1px solid rgba(243, 154, 24, 0.92);\n        }\n\n        .section-15__feature-item:last-child {\n            border-bottom: 0;\n        }\n\n        .section-15__feature-item-icon {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            width: 56px;\n            height: 56px;\n            flex: 0 0 56px;\n            padding: 12px;\n            border-radius: 50%;\n            background-color: #ffffff;\n            color: #f39a18;\n        }\n\n        .section-15__feature-item-icon-svg {\n            display: block;\n            width: 100%;\n            height: 100%;\n        }\n\n        .section-15__feature-item-body {\n            display: flex;\n            flex-direction: column;\n            gap: 0.22rem;\n            min-width: 0;\n        }\n\n        .section-15__feature-item-title {\n            margin: 0;\n            color: #ffffff;\n            font-size: clamp(1.05rem, 1.75vw, 1.32rem);\n            font-weight: 700;\n            line-height: 1.25;\n        }\n\n        .section-15__feature-item-text {\n            margin: 0;\n            color: #f2f4f8;\n            font-size: clamp(0.82rem, 1.25vw, 0.98rem);\n            line-height: 1.45;\n        }\n\n        .section-6 {\n            width: calc(100% - 4rem);\n            max-width: 1220px;\n            aspect-ratio: 2.05 / 1;\n            position: relative;\n            margin: 1.75rem auto;\n            overflow: hidden;\n            border-radius: 24px;\n            background-color: #eee9df;\n        }\n\n        .section-6__picture {\n            display: block;\n            width: 100%;\n            height: 100%;\n        }\n\n        .section-6__image {\n            display: block;\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n        }\n\n        .section-6__content {\n            position: absolute;\n            top: 50%;\n            left: 6.5%;\n            width: min(29%, 350px);\n            min-width: 270px;\n            transform: translateY(-50%);\n            z-index: 2;\n            padding: clamp(1.65rem, 3vw, 2.6rem);\n            border-radius: 22px;\n            background-color: rgba(255, 255, 255, 0.96);\n        }\n\n        .section-6__title {\n            margin: 0;\n            color: #0a1838;\n            font-size: clamp(1.75rem, 3vw, 2.45rem);\n            font-weight: 700;\n            line-height: 1.12;\n            letter-spacing: -0.02em;\n            text-shadow: none;\n        }\n\n        .section-6__title::after {\n            content: \"\";\n            display: block;\n            width: 34px;\n            height: 2px;\n            margin-top: 1.1rem;\n            border-radius: 999px;\n            background-color: #f39a18;\n        }\n\n        .section-6__description {\n            margin: 1.1rem 0 0;\n            color: #606060;\n            font-size: clamp(0.93rem, 1.55vw, 1.08rem);\n            line-height: 1.5;\n            text-shadow: none;\n        }\n\n        #faq-section {\n            width: 100%;\n            margin-top: 1.75rem;\n            padding: 2.8rem 2.5rem 2.9rem;\n            background-color: #fafaf7;\n        }\n\n        #faq-section__header {\n            width: 100%;\n            max-width: 1220px;\n            margin: 0 auto 1.35rem;\n            text-align: center;\n        }\n\n        #faq-section__title {\n            margin: 0;\n            color: #0a1838;\n            font-size: clamp(1.6rem, 2.8vw, 2.2rem);\n            font-weight: 700;\n            line-height: 1.2;\n        }\n\n        #faq-section__list {\n            display: flex;\n            flex-direction: column;\n            gap: 0.62rem;\n            width: 100%;\n            max-width: 1220px;\n            margin: 0 auto;\n            padding: 0;\n            list-style: none;\n        }\n\n        #faq-section__item {\n            width: 100%;\n            margin: 0;\n            padding: 0;\n            border: 0;\n            border-radius: 13px;\n            background-color: #ffffff;\n            box-shadow: 0 5px 14px rgba(10, 24, 56, 0.09);\n        }\n\n        #faq-section__details {\n            width: 100%;\n        }\n\n        #faq-section__summary {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 1rem;\n            min-height: 52px;\n            padding: 0.8rem 1.4rem;\n            cursor: pointer;\n            list-style: none;\n        }\n\n        #faq-section__summary::-webkit-details-marker {\n            display: none;\n        }\n\n        #faq-section__q-text {\n            margin: 0;\n            color: #111827;\n            font-size: clamp(0.82rem, 1.35vw, 0.98rem);\n            font-weight: 600;\n            line-height: 1.35;\n        }\n\n        #faq-section__icon {\n            position: relative;\n            display: block;\n            width: 18px;\n            height: 18px;\n            flex: 0 0 18px;\n        }\n\n        #faq-section__icon::before {\n            content: \"\";\n            position: absolute;\n            top: 50%;\n            left: 2px;\n            width: 14px;\n            height: 1.5px;\n            transform: translateY(-50%);\n            background-color: #313131;\n        }\n\n        #faq-section__icon::after {\n            content: \"\";\n            position: absolute;\n            top: 2px;\n            left: 50%;\n            width: 1.5px;\n            height: 14px;\n            transform: translateX(-50%);\n            background-color: #313131;\n        }\n\n        #faq-section__details[open] #faq-section__icon::after {\n            display: none;\n        }\n\n        #faq-section__a-inner {\n            padding: 0 1.4rem 1rem;\n        }\n\n        #faq-section__a-text {\n            margin: 0;\n            color: #606060;\n            font-size: clamp(0.84rem, 1.3vw, 0.96rem);\n            line-height: 1.5;\n        }\n\n        @media (max-width: 900px) {\n            .product-header-2 {\n                --badge-size: 104px;\n                --banner-height: 132px;\n            }\n\n            .product-header__body-2 {\n                padding-top: 53px;\n            }\n\n            .section-15-container {\n                padding-right: 1.5rem;\n                padding-left: 1.5rem;\n            }\n\n            .section-15__content {\n                padding: 2.2rem;\n            }\n\n            .section-15__feature-item-icon {\n                width: 50px;\n                height: 50px;\n                flex-basis: 50px;\n                padding: 10px;\n            }\n\n            .section-6 {\n                width: calc(100% - 3rem);\n            }\n\n            .section-6__content {\n                width: 32%;\n                min-width: 245px;\n                padding: 1.7rem;\n            }\n\n            #faq-section {\n                padding-right: 1.5rem;\n                padding-left: 1.5rem;\n            }\n        }\n\n        @media (max-width: 700px) {\n            .product-header-2 {\n                --badge-size: 92px;\n                --banner-height: 116px;\n            }\n\n            .product-header__banner-2::after {\n                bottom: -25px;\n                height: 48px;\n            }\n\n            .product-header__body-2 {\n                padding: 48px 20px 22px;\n            }\n\n            .product-header__title-2 {\n                font-size: clamp(1.7rem, 7vw, 2.25rem);\n                line-height: 1.05;\n            }\n\n            .product-header__subtitle-2 {\n                max-width: 92%;\n            }\n\n            .section-15-container {\n                padding-right: 1rem;\n                padding-left: 1rem;\n            }\n\n            .section-15 {\n                min-height: 0;\n                border-radius: 20px;\n            }\n\n            .is-reverse {\n                flex-direction: column-reverse;\n            }\n\n            .section-15__image-wrapper {\n                width: 100%;\n                min-height: 0;\n                flex-basis: auto;\n                aspect-ratio: 4 / 3;\n            }\n\n            .section-15__image {\n                min-height: 0;\n            }\n\n            .section-15__content {\n                flex-basis: auto;\n                padding: 2rem 1.5rem;\n            }\n\n            .section-15__feature-item {\n                padding: 1rem 0;\n            }\n\n            .section-6 {\n                width: calc(100% - 2rem);\n                min-height: 0;\n                aspect-ratio: auto;\n                margin-top: 1rem;\n                margin-bottom: 1rem;\n                border-radius: 20px;\n                overflow: hidden;\n                background-color: #ffffff;\n            }\n\n            .section-6__picture {\n                height: auto;\n            }\n\n            .section-6__image {\n                height: auto;\n                aspect-ratio: 4 / 3;\n                object-fit: cover;\n            }\n\n            .section-6__content {\n                position: static;\n                width: 100%;\n                min-width: 0;\n                transform: none;\n                padding: 1.7rem 1.5rem 1.9rem;\n                border-radius: 0;\n                background-color: #ffffff;\n            }\n\n            .section-6__title {\n                font-size: 1.85rem;\n            }\n\n            #faq-section {\n                margin-top: 1rem;\n                padding: 2.2rem 1rem 2.4rem;\n            }\n\n            #faq-section__summary {\n                min-height: 50px;\n                padding: 0.78rem 1rem;\n            }\n\n            #faq-section__a-inner {\n                padding: 0 1rem 1rem;\n            }\n        }\n    </style>\n\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        .product-header-2 {\n            --badge-size: 8rem;\n            --banner-height: 250px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            width: 100%;\n            position: relative;\n            container-type: inline-size;\n        }\n\n        .product-header__banner-2 {\n            width: 100%;\n            height: var(--banner-height);\n            position: relative;\n            display: flex;\n            justify-content: center;\n        }\n\n        .product-header__banner-2 figure {\n            width: 100%;\n            height: 100%;\n            margin: 0;\n        }\n\n        .product-header__banner-img-2 {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n        }\n\n        .product-header__badge-2 {\n            position: absolute;\n            bottom: calc(var(--badge-size) / -2);\n            width: var(--badge-size);\n            height: var(--badge-size);\n            background-color: #ff9900;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            overflow: hidden;\n            z-index: 10;\n        }\n\n        .product-header__badge-img-2 {\n            max-width: 90px;\n            max-height: 90px;\n            object-fit: contain;\n        }\n\n        .product-header__body-2 {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            padding: calc(var(--badge-size) / 2 + 1.8rem) 0.3rem 1.1rem;\n            text-align: center;\n        }\n\n        .product-header__brand-2 {\n            color: #ff9900;\n            font-size: 0.7rem;\n            font-weight: 700;\n            letter-spacing: 0.18em;\n            text-transform: uppercase;\n            margin-bottom: 0.75rem;\n        }\n\n        .product-header__title-2 {\n            font-size: clamp(1.4rem, 4vw, 2.4rem);\n            line-height: clamp(1.6rem, 4vw, 3.1rem);\n            font-weight: 300;\n            max-width: 50rem;\n            text-wrap: pretty;\n            color: #1a1a1a;\n        }\n\n        .product-header__title-2 strong {\n            font-weight: 700;\n            display: block;\n        }\n\n        .product-header__subtitle-2 {\n            color: #8a8a8a;\n            font-size: clamp(0.95rem, 2vw, 1.1rem);\n            line-height: 1.65;\n            margin-top: 1.25rem;\n            max-width: 48rem;\n            text-wrap: pretty;\n        }\n\n        @media (max-width: 768px) {\n            .product-header-2 {\n                --banner-height: 180px;\n            }\n        }\n\n        @media (max-width: 470px) {\n            .product-header__subtitle-2 {\n                font-size: clamp(0.9rem, 2vw, 1.1rem);\n                max-width: 95%;\n                margin: 1.25rem auto 0;\n            }\n        }\n    </style>\n\n    <!-- ----------------------------------------------------------------------------------------------------------------------------- -->\n    <article class=\"pdp\" id=\"pdp\" aria-label=\"Conteúdo rico do produto\">\n\n        <section class=\"product-header-2\" aria-label=\"Cabeçalho do produto\">\n            <div class=\"product-header__banner-2\">\n                <div class=\"product-header__badge-2\" role=\"img\" aria-label=\"Logo da marca\">\n                    <img src=\"https://static1.efacil.com.br/wcsstore//AuroraStorefrontAssetStore/PDP/nadir/logo-nadir.png\"\n                        alt=\"Ícone da marca\" class=\"product-header__badge-img-2\">\n                </div>\n            </div>\n            <div class=\"product-header__body-2\">\n                <small class=\"product-header__brand-2\"> nadir </small>\n                <h2 class=\"product-header__title-2\">\n                    <span>Conjunto de Pratos Rasos</span>\n                    <strong>Nadir Opaline Blanc 12 Peças</strong>\n                </h2>\n            </div>\n        </section>\n\n        <section class=\"section-15-container\" aria-labelledby=\"section-15-title\">\n            <div class=\"section-15 is-reverse\">\n                <div class=\"section-15__content\">\n                    <h2 class=\"section-15__title\" id=\"section-15-title\">\n                        Pratos para compor a mesa com elegância\n                    </h2>\n                    <p class=\"section-15__desc\">\n                        Em vidro temperado branco, o conjunto Opaline Blanc da Nadir reúne 12 pratos rasos de 27 cm para\n                        servir suas refeições com estilo.\n                    </p>\n                </div>\n\n                <div class=\"section-15__image-wrapper\">\n                    <img class=\"section-15__image\"\n                        src=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/prato-raso-nadir-opaline-blanc-vidro-branco-mesa-posta-refeicao-3021052-03.webp\"\n                        alt=\"Conjunto de pratos rasos Nadir Opaline Blanc em vidro branco\">\n                </div>\n            </div>\n        </section>\n\n        <section class=\"section-6\" aria-labelledby=\"section-6-title\">\n            <picture class=\"section-6__picture\">\n                <source media=\"(max-width: 760px)\"\n                    srcset=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/prato-raso-nadir-opaline-blanc-vidro-branco-vista-superior-3021052-01-2.webp\"\n                    width=\"780\" height=\"450\">\n                <img class=\"section-6__image\" width=\"1600\" height=\"650\" loading=\"lazy\" fetchpriority=\"low\"\n                    decoding=\"async\"\n                    src=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/prato-raso-nadir-opaline-blanc-vidro-branco-banner-top-down-3021052-01-1.webp\"\n                    alt=\"Conjunto de Pratos Rasos Nadir Opaline Blanc 12 Peças\">\n            </picture>\n            <div class=\"section-6__content\">\n                <h2 class=\"section-6__title\" id=\"section-6-title\">Elegância em vidro branco</h2>\n                <p class=\"section-6__description\">Pratos rasos de 27 cm para servir suas refeições com estilo.</p>\n            </div>\n        </section>\n\n        <section class=\"section-15-container\"\n            aria-label=\"Destaques do Conjunto de Pratos Rasos Nadir Opaline Blanc 12 Peças\">\n            <div class=\"section-15 is-reverse\">\n                <div class=\"section-15__content\">\n                    <ul class=\"section-15__feature-list\"\n                        aria-label=\"Destaques do Conjunto de Pratos Rasos Nadir Opaline Blanc 12 Peças\">\n\n                        <li class=\"section-15__feature-item\">\n                            <span class=\"section-15__feature-item-icon\" aria-hidden=\"true\">\n                                <svg class=\"section-15__feature-item-icon-svg\" viewBox=\"0 0 24 24\" fill=\"none\"\n                                    xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path d=\"M4.5 7.5L12 3.5L19.5 7.5L12 11.5L4.5 7.5Z\" stroke=\"currentColor\"\n                                        stroke-width=\"1.7\" stroke-linejoin=\"round\" />\n                                    <path d=\"M4.5 7.5V16.5L12 20.5L19.5 16.5V7.5\" stroke=\"currentColor\"\n                                        stroke-width=\"1.7\" stroke-linejoin=\"round\" />\n                                    <path d=\"M12 11.5V20.5\" stroke=\"currentColor\" stroke-width=\"1.7\"\n                                        stroke-linejoin=\"round\" />\n                                </svg>\n                            </span>\n                            <div class=\"section-15__feature-item-body\">\n                                <strong class=\"section-15__feature-item-title\">Conjunto com 12 peças</strong>\n                                <p class=\"section-15__feature-item-text\">O conjunto é composto por 12 pratos rasos.</p>\n                            </div>\n                        </li>\n\n                        <li class=\"section-15__feature-item\">\n                            <span class=\"section-15__feature-item-icon\" aria-hidden=\"true\">\n                                <svg class=\"section-15__feature-item-icon-svg\" viewBox=\"0 0 24 24\" fill=\"none\"\n                                    xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path\n                                        d=\"M12 3.5L19 6.2V11.2C19 15.5 16.2 18.7 12 20.5C7.8 18.7 5 15.5 5 11.2V6.2L12 3.5Z\"\n                                        stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\" />\n                                    <path d=\"M9 12L11 14L15.3 9.7\" stroke=\"currentColor\" stroke-width=\"1.7\"\n                                        stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n                                </svg>\n                            </span>\n                            <div class=\"section-15__feature-item-body\">\n                                <strong class=\"section-15__feature-item-title\">Vidro Temperado</strong>\n                                <p class=\"section-15__feature-item-text\">Pratos produzidos em vidro temperado na cor\n                                    branca.</p>\n                            </div>\n                        </li>\n\n                        <li class=\"section-15__feature-item\">\n                            <span class=\"section-15__feature-item-icon\" aria-hidden=\"true\">\n                                <svg class=\"section-15__feature-item-icon-svg\" viewBox=\"0 0 24 24\" fill=\"none\"\n                                    xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path\n                                        d=\"M5.2 17.8L17.8 5.2C18.6 4.4 19.8 4.4 20.6 5.2L18.8 3.4C19.6 4.2 19.6 5.4 18.8 6.2L6.2 18.8C5.4 19.6 4.2 19.6 3.4 18.8L5.2 20.6C4.4 19.8 4.4 18.6 5.2 17.8Z\"\n                                        stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\" />\n                                    <path d=\"M9.2 13.8L10.7 15.3M12 11L13.5 12.5M14.8 8.2L16.3 9.7\"\n                                        stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" />\n                                </svg>\n                            </span>\n                            <div class=\"section-15__feature-item-body\">\n                                <strong class=\"section-15__feature-item-title\">27 cm de Diâmetro</strong>\n                                <p class=\"section-15__feature-item-text\">Cada prato possui 27 cm de diâmetro.</p>\n                            </div>\n                        </li>\n                    </ul>\n                </div>\n\n                <div class=\"section-15__image-wrapper\">\n                    <img class=\"section-15__image\"\n                        src=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/prato-raso-nadir-opaline-blanc-vidro-branco-servindo-salada-buffet-3021052-02.webp\"\n                        alt=\"Conjunto de pratos rasos Nadir Opaline Blanc 12 peças em destaque\">\n                </div>\n            </div>\n        </section>\n\n        <link rel=\"stylesheet\" href=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/style-faq-padrao.css\">\n\n        <section id=\"faq-section\" aria-labelledby=\"faq-section__title\">\n            <div id=\"faq-section__header\">\n                <h2 id=\"faq-section__title\">Dúvidas Frequentes</h2>\n            </div>\n            <ul id=\"faq-section__list\" role=\"list\"> <!-- Cole aqui as perguntas e respostas -->\n                <li id=\"faq-section__item\">\n                    <details id=\"faq-section__details\">\n                        <summary id=\"faq-section__summary\">\n                            <h3 id=\"faq-section__q-text\"> O Conjunto de Pratos Rasos Nadir Opaline Blanc é uma boa opção\n                                para montar uma mesa com vários lugares? </h3>\n                            <span id=\"faq-section__icon\" aria-hidden=\"true\"></span>\n                        </summary>\n                        <div id=\"faq-section__a-inner\">\n                            <p id=\"faq-section__a-text\"> O conjunto traz 12 pratos rasos iguais, todos brancos e com 27\n                                cm de diâmetro. A quantidade permite compor até 12 lugares utilizando um prato raso por\n                                pessoa, mantendo o mesmo padrão visual em toda a mesa. </p>\n                        </div>\n                    </details>\n                </li>\n                <!-------------------------->\n\n                <!-- Cole aqui as perguntas e respostas -->\n                <li id=\"faq-section__item\">\n                    <details id=\"faq-section__details\">\n                        <summary id=\"faq-section__summary\">\n                            <h3 id=\"faq-section__q-text\"> Os pratos são de porcelana ou de vidro? </h3>\n                            <span id=\"faq-section__icon\" aria-hidden=\"true\"></span>\n                        </summary>\n                        <div id=\"faq-section__a-inner\">\n                            <p id=\"faq-section__a-text\"> São produzidos em vidro temperado. O conjunto pertence à linha\n                                branca Opaline Blanc da Nadir e reúne 12 peças rasas com o mesmo material, cor e\n                                dimensões. </p>\n                        </div>\n                    </details>\n                </li>\n                <!-------------------------->\n\n                <!-- Cole aqui as perguntas e respostas -->\n                <li id=\"faq-section__item\">\n                    <details id=\"faq-section__details\">\n                        <summary id=\"faq-section__summary\">\n                            <h3 id=\"faq-section__q-text\"> O branco dos pratos facilita combinar o conjunto com outros\n                                itens da mesa? </h3>\n                            <span id=\"faq-section__icon\" aria-hidden=\"true\"></span>\n                        </summary>\n                        <div id=\"faq-section__a-inner\">\n                            <p id=\"faq-section__a-text\"> O conjunto possui acabamento totalmente branco, uma\n                                característica visual neutra que permite compor a mesa junto a diferentes cores de\n                                talheres, copos e demais itens já utilizados no ambiente. </p>\n                        </div>\n                    </details>\n                </li>\n                <!-------------------------->\n\n                <!-- Cole aqui as perguntas e respostas -->\n                <li id=\"faq-section__item\">\n                    <details id=\"faq-section__details\">\n                        <summary id=\"faq-section__summary\">\n                            <h3 id=\"faq-section__q-text\"> As 12 peças do conjunto possuem o mesmo tamanho? </h3>\n                            <span id=\"faq-section__icon\" aria-hidden=\"true\"></span>\n                        </summary>\n                        <div id=\"faq-section__a-inner\">\n                            <p id=\"faq-section__a-text\"> Sim. Todas as unidades são pratos rasos de 27 cm de diâmetro e\n                                1,91 cm de altura. Isso mantém uniformidade de tamanho entre os 12 pratos durante a\n                                montagem da mesa. </p>\n                        </div>\n                    </details>\n                </li>\n                <!-------------------------->\n\n                <!-- Cole aqui as perguntas e respostas -->\n                <li id=\"faq-section__item\">\n                    <details id=\"faq-section__details\">\n                        <summary id=\"faq-section__summary\">\n                            <h3 id=\"faq-section__q-text\"> Os pratos são muito pesados para manusear no dia a dia? </h3>\n                            <span id=\"faq-section__icon\" aria-hidden=\"true\"></span>\n                        </summary>\n                        <div id=\"faq-section__a-inner\">\n                            <p id=\"faq-section__a-text\"> Cada prato pesa aproximadamente 500 g. Como o conjunto possui\n                                12 unidades, as peças somam cerca de 6 kg, enquanto o produto acondicionado na embalagem\n                                apresenta peso total de 6,30 kg. </p>\n                        </div>\n                    </details>\n                </li>\n                <!-------------------------->\n            </ul>\n        </section>\n\n    </article>\n</div>",
