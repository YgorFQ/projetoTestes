  "html": "<div class=\"lp-container\">\n    <!-- ---------------------------------------- ÁREA PARA COLOCAR STYLES ----------------------------------------------------------- -->\n\n    <link rel=\"stylesheet\" href=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/style-faq-padrao.css\">\n    <link rel=\"stylesheet\" href=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/style-html-padrao.css\">\n\n    <style>\n        .lp-container,\n        .lp-container * {\n            margin: 0;\n            padding: 0;\n        }\n\n        .lp-container .pdp {\n            width: 100%;\n            min-width: 0;\n            display: flex;\n            flex-direction: column;\n            font-family: Arial, sans-serif;\n        }\n\n        .lp-container .pdp *,\n        .lp-container .pdp *::before,\n        .lp-container .pdp *::after {\n            box-sizing: border-box;\n        }\n\n        .video-header,\n        .video-header * {\n            box-sizing: border-box;\n            margin: 0;\n        }\n\n        .video-header {\n            --badge-size: 8rem;\n            --banner-height: 250px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            width: 100%;\n            position: relative;\n            font-family: sans-serif;\n            container-type: inline-size;\n        }\n\n        .video-header__banner {\n            width: 100%;\n            height: var(--banner-height);\n            position: relative;\n            display: flex;\n            justify-content: center;\n        }\n\n        .video-header__banner-video {\n            position: absolute;\n            inset: 0;\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            pointer-events: none;\n        }\n\n        .video-header__badge {\n            position: absolute;\n            bottom: calc(var(--badge-size) / -2);\n            width: var(--badge-size);\n            height: var(--badge-size);\n            background-color: #ff9900;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            overflow: hidden;\n            z-index: 10;\n        }\n\n        .video-header__badge-img {\n            max-width: 90px;\n            max-height: 90px;\n            object-fit: contain;\n        }\n\n        .video-header__body {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            padding: calc(var(--badge-size) / 2 + 1.1rem) 0.3rem .8rem;\n            text-align: center;\n        }\n\n        .video-header__brand {\n            color: #ff9900;\n            font-size: 0.75rem;\n            font-weight: 700;\n            text-transform: uppercase;\n            margin-bottom: 0.5rem;\n        }\n\n        .video-header__title {\n            color: #000;\n            font-size: clamp(1.4rem, 4vw, 2.4rem);\n            line-height: clamp(1.6rem, 4vw, 3.1rem);\n            font-weight: 600;\n            max-width: 50rem;\n            text-wrap: pretty;\n        }\n\n        .video-header__subtitle {\n            color: #8a8a8a;\n            font-size: clamp(1rem, 2vw, 1.2rem);\n            line-height: 120%;\n            margin-top: 1rem;\n            max-width: 52rem;\n            text-wrap: pretty;\n        }\n\n        @media (prefers-contrast: more) {\n            .video-header__subtitle {\n                color: #000;\n            }\n\n            .video-header__brand {\n                color: #3a2301;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .video-header {\n                --banner-height: 180px;\n            }\n        }\n\n        @media (max-width: 470px) {\n            .video-header__subtitle {\n                font-size: clamp(0.9rem, 2vw, 1.5rem);\n                font-weight: 550;\n            }\n        }\n    </style>\n\n    <style>\n        .section-28 {\n            --s8-color-brand: #b1257a;\n            --s8-color-ink: #081844;\n            --s8-color-muted: #5b6682;\n            --s8-color-soft: #dfeaff;\n            --s8-color-line: #b1257a;\n            --s8-color-surface: #ffffff;\n\n            width: 100%;\n            position: relative;\n            padding: 0 1rem 1.5rem;\n            box-sizing: border-box;\n            font-family: Roboto, Arial, sans-serif;\n            color: var(--s8-color-ink);\n            overflow-wrap: anywhere;\n        }\n\n        .section-28,\n        .section-28 * {\n            box-sizing: border-box;\n        }\n\n        .section-28__title-accessible {\n            width: 1px;\n            height: 1px;\n            position: absolute;\n            overflow: hidden;\n            margin: 0;\n            padding: 0;\n            clip-path: inset(50%);\n            white-space: nowrap;\n        }\n\n        .section-28__inner {\n            width: 100%;\n            min-width: 0;\n            display: flex;\n            flex-direction: column;\n            align-items: stretch;\n            gap: 1rem;\n            padding: 1rem;\n            overflow: hidden;\n            border: 1px solid rgba(8, 24, 68, 0.08);\n            border-radius: 1.5rem;\n            background: var(--s8-color-surface);\n            box-shadow: 0 1rem 2.5rem rgba(3, 33, 82, 0.1);\n        }\n\n        .section-28__tabs {\n            width: 100%;\n            min-width: 0;\n            display: grid;\n            grid-template-columns: repeat(2, minmax(0, 1fr));\n            align-items: stretch;\n            gap: 0.75rem;\n            order: 1;\n        }\n\n        .section-28__option {\n            min-width: 0;\n            position: relative;\n        }\n\n        .section-28__control {\n            position: absolute;\n            width: 1px;\n            height: 1px;\n            opacity: 0;\n            pointer-events: none;\n        }\n\n        .section-28__tab {\n            width: 100%;\n            height: 100%;\n            min-height: 3.5rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 0.5rem;\n            padding: 0.875rem 0.75rem;\n            border: 1px solid var(--s8-color-line);\n            border-radius: 999px;\n            background: var(--s8-color-surface);\n            color: var(--s8-color-brand);\n            cursor: pointer;\n            transition:\n                background-color 240ms ease,\n                border-color 240ms ease,\n                color 240ms ease,\n                transform 240ms ease;\n        }\n\n        .section-28__control:focus-visible+.section-28__tab {\n            outline: 0.125rem solid var(--s8-color-brand);\n            outline-offset: 0.25rem;\n        }\n\n        .section-28__tab-icon {\n            width: 1.5rem;\n            height: 1.5rem;\n            flex: 0 0 1.5rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .section-28__tab-icon-svg {\n            width: 1.5rem;\n            height: 1.5rem;\n            display: block;\n        }\n\n        .section-28__tab-text {\n            min-width: 0;\n            color: currentColor;\n            font-size: clamp(0.75rem, 2.8vw, 0.9375rem);\n            font-weight: 700;\n            line-height: 1.3;\n            text-align: center;\n            overflow-wrap: anywhere;\n        }\n\n        .section-28__viewport {\n            width: 100%;\n            min-width: 0;\n            position: relative;\n            overflow: hidden;\n            border-radius: 1.5rem;\n            background: var(--s8-color-surface);\n        }\n\n        /*\n         * Os painéis inativos ficam absolutos para não interferirem\n         * na altura do painel atualmente selecionado.\n         */\n        .section-28__panel {\n            width: 100%;\n            min-width: 0;\n            position: absolute;\n            inset: 0;\n            display: flex;\n            flex-direction: column;\n            align-items: stretch;\n            opacity: 0;\n            visibility: hidden;\n            pointer-events: none;\n            transform: translateX(1rem);\n            transition:\n                opacity 320ms ease,\n                transform 320ms ease,\n                visibility 0s linear 320ms;\n        }\n\n        .section-28__figure {\n            width: 100%;\n            aspect-ratio: 16 / 10;\n            margin: 0;\n            overflow: hidden;\n            border-radius: 1.5rem 1.5rem 0 0;\n            background: var(--s8-color-soft);\n        }\n\n        .section-28__figure picture {\n            width: 100%;\n            height: 100%;\n            display: block;\n        }\n\n        .section-28__image {\n            width: 100%;\n            height: 100%;\n            display: block;\n            object-fit: cover;\n            object-position: center;\n        }\n\n        /* MOBILE: caixa abaixo da imagem */\n        .section-28__content {\n            width: 100%;\n            min-width: 0;\n            display: flex;\n            flex-direction: column;\n            align-items: flex-start;\n            padding: 1.5rem;\n            border: 1px solid var(--s8-color-line);\n            border-top: 0;\n            border-radius: 0 0 1.5rem 1.5rem;\n            background: var(--s8-color-surface);\n            overflow-wrap: anywhere;\n        }\n\n        .section-28__title {\n            margin: 0;\n            color: var(--s8-color-ink);\n            font-size: clamp(1.25rem, 5vw, 1.75rem);\n            font-weight: 500;\n            line-height: 1.2;\n            overflow-wrap: anywhere;\n            text-wrap: balance;\n        }\n\n        .section-28__rule {\n            width: 3rem;\n            height: 0.125rem;\n            flex: 0 0 auto;\n            margin: 1rem 0;\n            border-radius: 999px;\n            background: var(--s8-color-brand);\n        }\n\n        .section-28__copy {\n            margin: 0;\n            color: var(--s8-color-muted);\n            font-size: clamp(0.875rem, 3.5vw, 1rem);\n            font-weight: 400;\n            line-height: 1.6;\n            overflow-wrap: anywhere;\n            text-wrap: pretty;\n        }\n\n        .section-28__dots {\n            width: 100%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 1rem;\n        }\n\n        .section-28__dot {\n            width: 1rem;\n            height: 1rem;\n            flex: 0 0 1rem;\n            border: 1px solid var(--s8-color-brand);\n            border-radius: 50%;\n            background: var(--s8-color-surface);\n            transition:\n                background-color 240ms ease,\n                transform 240ms ease;\n        }\n\n        .section-28:has(.section-28__control--protection:checked) .section-28__tab--protection,\n        .section-28:has(.section-28__control--care:checked) .section-28__tab--care,\n        .section-28:has(.section-28__control--fragrance:checked) .section-28__tab--fragrance,\n        .section-28:has(.section-28__control--application:checked) .section-28__tab--application {\n            border-color: var(--s8-color-brand);\n            background: var(--s8-color-brand);\n            color: var(--s8-color-surface);\n            transform: translateY(-0.25rem);\n        }\n\n        .section-28:has(.section-28__control--protection:checked) .section-28__panel--protection,\n        .section-28:has(.section-28__control--care:checked) .section-28__panel--care,\n        .section-28:has(.section-28__control--fragrance:checked) .section-28__panel--fragrance,\n        .section-28:has(.section-28__control--application:checked) .section-28__panel--application {\n            position: relative;\n            inset: auto;\n            opacity: 1;\n            visibility: visible;\n            pointer-events: auto;\n            transform: translateX(0);\n            transition-delay: 0s;\n            z-index: 1;\n        }\n\n        .section-28:has(.section-28__control--protection:checked) .section-28__dot--protection,\n        .section-28:has(.section-28__control--care:checked) .section-28__dot--care,\n        .section-28:has(.section-28__control--fragrance:checked) .section-28__dot--fragrance,\n        .section-28:has(.section-28__control--application:checked) .section-28__dot--application {\n            background: var(--s8-color-brand);\n            transform: scale(1.25);\n        }\n\n        @media (max-width: 420px) {\n            .section-28 {\n                padding-inline: 0.75rem;\n            }\n\n            .section-28__inner {\n                padding: 0.75rem;\n                border-radius: 1.25rem;\n            }\n\n            .section-28__tabs {\n                gap: 0.5rem;\n            }\n\n            .section-28__tab {\n                min-height: 3.25rem;\n                padding: 0.75rem 0.5rem;\n            }\n\n            .section-28__content {\n                padding: 1.25rem;\n            }\n        }\n\n        @media (min-width: 576px) {\n            .section-28 {\n                padding: 0 1.5rem 1.5rem;\n            }\n\n            .section-28__inner {\n                padding: 1.5rem;\n            }\n\n            .section-28__content {\n                padding: 2rem;\n            }\n\n            .section-28__tab-text {\n                font-size: clamp(0.875rem, 2vw, 1rem);\n            }\n        }\n\n        @media (min-width: 768px) {\n            .section-28 {\n                padding: 0 2rem 1.5rem;\n            }\n\n            .section-28__inner {\n                gap: 1.5rem;\n            }\n\n            .section-28__figure {\n                width: 100%;\n                height: 650px;\n                min-height: 650px;\n                max-height: 650px;\n                aspect-ratio: auto;\n                border-radius: 1.5rem;\n            }\n\n            .section-28__figure picture,\n            .section-28__image {\n                width: 100%;\n                height: 650px;\n            }\n\n            .section-28__panel {\n                display: block;\n            }\n\n            /* DESKTOP: caixa totalmente contida dentro da imagem */\n            .section-28__content {\n                width: min(40%, 28rem);\n                max-height: calc(100% - 2rem);\n                position: absolute;\n                top: 50%;\n                overflow: auto;\n                padding: 1.5rem;\n                border: 1px solid var(--s8-color-line);\n                border-radius: 1.5rem;\n                background: var(--s8-color-surface);\n                box-shadow: 0 1rem 2.5rem rgba(3, 33, 82, 0.16);\n                transform: translateY(-50%);\n            }\n\n            .section-28__title {\n                font-size: clamp(1.375rem, 2.5vw, 2rem);\n            }\n\n            .section-28__copy {\n                font-size: clamp(0.875rem, 1.5vw, 1rem);\n            }\n\n            /* POSICIONAMENTO INDEPENDENTE DE CADA CAIXA */\n            .section-28__panel--protection .section-28__content {\n                left: 5%;\n            }\n\n            .section-28__panel--care .section-28__content {\n                right: 5%;\n                left: auto;\n            }\n        }\n\n        @media (min-width: 992px) {\n            .section-28 {\n                padding: 0 2.5rem 1.5rem;\n            }\n\n            .section-28__content {\n                width: min(36%, 28rem);\n                max-height: calc(100% - 3rem);\n                padding: 2rem;\n            }\n        }\n\n        @media (min-width: 1200px) {\n            .section-28 {\n                padding: 0 3rem 1.5rem;\n            }\n\n            .section-28__content {\n                width: min(34%, 28rem);\n                max-height: calc(100% - 4rem);\n            }\n        }\n\n        @media (min-width: 1400px) {\n            .section-28 {\n                padding: 0 3rem 1.5rem;\n            }\n        }\n    </style>\n\n    <!-- ----------------------------------------------------------------------------------------------------------------------------- -->\n\n    <article class=\"pdp\" id=\"pdp\"\n        aria-label=\"Conteúdo rico do Creme de Tratamento Salon Line Cachos dos Sonhos Multy Pink Lemonade 3 em 1 1kg\">\n        <!-- HTML fica dentro dessa diiiiiiiiiiv PDP -->\n\n        <section class=\"video-header\">\n            <div class=\"video-header__banner\">\n                <video class=\"video-header__banner-video\"\n                    poster=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/header-salonline.webp\"\n                    preload=\"none\" autoplay muted loop playsinline width=\"1200\" height=\"250\">\n                    <source src=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/header-salonline.webm\">\n                </video>\n\n                <div class=\"video-header__badge\">\n                    <img class=\"video-header__badge-img\"\n                        src=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/logo-salonline.webp\"\n                        alt=\"logo da marca Salon Line\">\n                </div>\n            </div>\n\n            <div class=\"video-header__body\">\n                <small class=\"video-header__brand\">Salon Line</small>\n\n                <h2 class=\"video-header__title\">\n                    Creme de Tratamento Cachos dos Sonhos Multy Pink Lemonade 3 em 1\n                </h2>\n\n                <p class=\"video-header__subtitle\">\n                    Cuidado 3 em 1 para cabelos ondulados, cacheados e crespos, com fórmula vegana e fragrância frutal\n                    cítrica.\n                </p>\n            </div>\n        </section>\n\n        <section class=\"section-28\" aria-labelledby=\"section-8-title\">\n            <h2 class=\"section-28__title-accessible\" id=\"section-8-title\">\n                Benefícios do Creme de Tratamento Salon Line Cachos dos Sonhos Multy Pink Lemonade 3 em 1\n            </h2>\n\n            <div class=\"section-28__inner\">\n                <div class=\"section-28__tabs\" role=\"radiogroup\"\n                    aria-label=\"Benefícios do Creme de Tratamento Salon Line Cachos dos Sonhos Multy Pink Lemonade 3 em 1\">\n\n                    <div class=\"section-28__option\">\n                        <input class=\"section-28__control section-28__control--protection\"\n                            id=\"section-8-control-protection\" type=\"radio\" name=\"section-8-tabs\" checked>\n\n                        <label class=\"section-28__tab section-28__tab--protection\" for=\"section-8-control-protection\">\n                            <span class=\"section-28__tab-text\">Hidratação e brilho glow</span>\n                        </label>\n                    </div>\n\n                    <div class=\"section-28__option\">\n                        <input class=\"section-28__control section-28__control--care\" id=\"section-8-control-care\"\n                            type=\"radio\" name=\"section-8-tabs\">\n\n                        <label class=\"section-28__tab section-28__tab--care\" for=\"section-8-control-care\">\n                            <span class=\"section-28__tab-text\">Versatilidade 3 em 1</span>\n                        </label>\n                    </div>\n                </div>\n\n                <div class=\"section-28__viewport\">\n                    <div class=\"section-28__panel section-28__panel--protection\">\n                        <figure class=\"section-28__figure\">\n                            <picture>\n                                <source media=\"(max-width: 768px)\"\n                                    srcset=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/creme-tratamento-salon-line-cachos-dos-sonhos-pink-lemonade-1kg-produto-central-frutas-citricas-113241-01-02.webp\">\n\n                                <img class=\"section-28__image\" width=\"1600\" height=\"650\" loading=\"lazy\" decoding=\"async\"\n                                    src=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/creme-tratamento-salon-line-cachos-dos-sonhos-pink-lemonade-1kg-produto-direita-frutas-citricas-113241-01-01.webp\"\n                                    alt=\"Creme 3 em 1 Salon Line Cachos dos Sonhos Pink Lemonade 1kg à direita, com frutas cítricas sobre base rosa.\">\n                            </picture>\n                        </figure>\n\n                        <div class=\"section-28__content\">\n                            <h3 class=\"section-28__title\">\n                                Hidratação profunda\n                            </h3>\n\n                            <span class=\"section-28__rule\" aria-hidden=\"true\"></span>\n\n                            <p class=\"section-28__copy\">\n                                Oferece tratamento intenso, ajuda a controlar o frizz e proporciona brilho glow\n                                radiante.\n                            </p>\n                        </div>\n                    </div>\n\n                    <div class=\"section-28__panel section-28__panel--care\">\n                        <figure class=\"section-28__figure\">\n                            <picture>\n                                <source media=\"(max-width: 768px)\"\n                                    srcset=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/creme-tratamento-salon-line-cachos-dos-sonhos-pink-lemonade-1kg-modelo-cacheada-frutas-citricas-113241-02-02.webp\">\n\n                                <img class=\"section-28__image\" width=\"1200\" height=\"800\" loading=\"lazy\" decoding=\"async\"\n                                    src=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/creme-tratamento-salon-line-cachos-dos-sonhos-pink-lemonade-1kg-modelo-cabelos-cacheados-113241-02-01.webp\"\n                                    alt=\"Mulher com cachos volumosos ao lado do creme Salon Line Pink Lemonade 1kg, com frutas cítricas e fundo rosa.\">\n                            </picture>\n                        </figure>\n\n                        <div class=\"section-28__content\">\n                            <h3 class=\"section-28__title\">\n                                Tratamento e finalização\n                            </h3>\n\n                            <span class=\"section-28__rule\" aria-hidden=\"true\"></span>\n\n                            <p class=\"section-28__copy\">\n                                Pode ser usado como creme de tratamento, super condicionador ou creme para pentear.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"section-28__dots\" aria-hidden=\"true\">\n                    <span class=\"section-28__dot section-28__dot--protection\"></span>\n                    <span class=\"section-28__dot section-28__dot--care\"></span>\n                </div>\n            </div>\n        </section>\n\n        <p style=\"color: #8a8a8a; font-size: clamp(1rem, 2vw, 1.2rem); text-wrap: pretty;\n            text-align: center; padding: 30px 0;\">\n            IMAGENS MERAMENTE ILUSTRATIVAS\n        </p>\n\n        <!-- Área de FAQ -->\n        <link rel=\"stylesheet\"\n            href=\"https://imgprd.martinsatacado.com.br/catalogoimg/catalogo/style-faq-padrao-conteudo.css\">\n\n        <style>\n            /* Base autônoma do FAQ: substitui os stylesheets externos. */\n            .lp-container #faq-section,\n            .lp-container #faq-section * {\n                box-sizing: border-box;\n            }\n\n            .lp-container #faq-section__header {\n                text-align: center;\n            }\n\n            .lp-container #faq-section__list {\n                width: 100%;\n                max-width: 60rem;\n                margin-inline: auto;\n                padding: 0;\n                list-style: none;\n            }\n\n            .lp-container #faq-section__details {\n                width: 100%;\n            }\n\n            .lp-container #faq-section__summary {\n                display: flex;\n                align-items: center;\n                justify-content: space-between;\n                gap: 0.75rem;\n                list-style: none;\n                cursor: pointer;\n            }\n\n            .lp-container #faq-section__summary::-webkit-details-marker {\n                display: none;\n            }\n\n            .lp-container #faq-section__q-text {\n                min-width: 0;\n                flex: 1;\n            }\n\n            .lp-container #faq-section__icon {\n                width: 1.25rem;\n                height: 1.25rem;\n                position: relative;\n                flex: 0 0 1.25rem;\n            }\n\n            .lp-container #faq-section__icon::before,\n            .lp-container #faq-section__icon::after {\n                content: \"\";\n                position: absolute;\n                left: 50%;\n                top: 50%;\n                border-radius: 999px;\n                background: var(--toon-ink, #2b1535);\n                transform: translate(-50%, -50%);\n                transition: transform 180ms ease, opacity 180ms ease;\n            }\n\n            .lp-container #faq-section__icon::before {\n                width: 0.7rem;\n                height: 0.12rem;\n            }\n\n            .lp-container #faq-section__icon::after {\n                width: 0.12rem;\n                height: 0.7rem;\n            }\n\n            .lp-container #faq-section__details[open] #faq-section__icon::after {\n                opacity: 0;\n                transform: translate(-50%, -50%) rotate(90deg);\n            }\n        </style>\n\n        <style>\n            /* =========================================================\n               TEMA CARTOON — apenas apresentação; lógica preservada\n               ========================================================= */\n            .lp-container {\n                --toon-ink: #2b1535;\n                --toon-pink: #f72b88;\n                --toon-pink-dark: #b61566;\n                --toon-lime: #dcf52f;\n                --toon-yellow: #ffd84d;\n                --toon-cream: #fff8de;\n                --toon-paper: #fffdf4;\n                --toon-cyan: #71e4df;\n                width: 100%;\n                min-width: 0;\n                max-width: 100%;\n                overflow-x: clip;\n                color: var(--toon-ink);\n                background:\n                    radial-gradient(circle, rgba(247, 43, 136, 0.09) 0 2px, transparent 2.5px) 0 0 / 22px 22px,\n                    #fff;\n            }\n\n            .lp-container,\n            .lp-container * {\n                box-sizing: border-box;\n            }\n\n            .lp-container .pdp {\n                min-width: 0;\n                max-width: 100%;\n                font-family: \"Trebuchet MS\", Arial, sans-serif;\n            }\n\n            /* Cabeçalho como painel de quadrinhos */\n            .lp-container .video-header {\n                --badge-size: 8rem;\n                padding: 0 clamp(0.75rem, 3vw, 3rem);\n                font-family: \"Trebuchet MS\", Arial, sans-serif;\n            }\n\n            .lp-container .video-header__banner {\n                width: 100%;\n                overflow: visible;\n                border: 0.2rem solid var(--toon-ink);\n                border-radius: 0 0 1.75rem 1.75rem;\n                background: var(--toon-pink);\n                box-shadow: 0.55rem 0.55rem 0 var(--toon-ink);\n            }\n\n            .lp-container .video-header__banner-video {\n                border-radius: 0 0 1.5rem 1.5rem;\n            }\n\n            .lp-container .video-header__badge {\n                padding: 0.65rem;\n                overflow: hidden;\n                border: 0.25rem solid var(--toon-ink);\n                background: #ff9900;\n                box-shadow: 0.4rem 0.4rem 0 var(--toon-ink);\n                transform: rotate(-3deg);\n            }\n\n            .lp-container .video-header__badge-img {\n                width: 100%;\n                height: 100%;\n                object-fit: contain;\n            }\n\n            .lp-container .video-header__body {\n                width: min(100%, 58rem);\n                padding-inline: 0.75rem;\n            }\n\n            .lp-container .video-header__brand {\n                display: inline-flex;\n                align-items: center;\n                min-height: 1.8rem;\n                padding: 0.3rem 0.75rem;\n                border: 0.125rem solid var(--toon-ink);\n                border-radius: 999px;\n                color: var(--toon-ink);\n                background: var(--toon-yellow);\n                box-shadow: 0.2rem 0.2rem 0 var(--toon-ink);\n                font-weight: 900;\n                letter-spacing: 0.08em;\n                transform: rotate(-2deg);\n            }\n\n            .lp-container .video-header__title {\n                max-width: 100%;\n                color: var(--toon-ink);\n                font-family: \"Arial Rounded MT Bold\", \"Trebuchet MS\", Arial, sans-serif;\n                font-weight: 900;\n                line-height: 1.05;\n                letter-spacing: -0.035em;\n                overflow-wrap: anywhere;\n                text-shadow: 0.11rem 0.11rem 0 rgba(247, 43, 136, 0.18);\n            }\n\n            .lp-container .video-header__subtitle {\n                color: #5d3f62;\n                font-weight: 600;\n                line-height: 1.5;\n            }\n\n            /* Moldura principal com retícula de gibi */\n            .lp-container .section-28 {\n                --s8-color-brand: var(--toon-pink);\n                --s8-color-ink: var(--toon-ink);\n                --s8-color-muted: #604763;\n                --s8-color-soft: #ffd5e8;\n                --s8-color-line: var(--toon-ink);\n                --s8-color-surface: var(--toon-paper);\n                padding-bottom: 2rem;\n                color: var(--toon-ink);\n                font-family: \"Trebuchet MS\", Arial, sans-serif;\n            }\n\n            .lp-container .section-28__inner {\n                gap: 1.1rem;\n                overflow: visible;\n                border: 0.2rem solid var(--toon-ink);\n                border-radius: 1.75rem;\n                background:\n                    radial-gradient(circle, rgba(247, 43, 136, 0.11) 0 2px, transparent 2.5px) 0 0 / 20px 20px,\n                    var(--toon-cream);\n                box-shadow: 0.55rem 0.55rem 0 var(--toon-ink);\n            }\n\n            .lp-container .section-28__viewport {\n                overflow: hidden;\n                border: 0.2rem solid var(--toon-ink);\n                border-radius: 1.45rem;\n                background: var(--toon-pink);\n                box-shadow: 0.3rem 0.3rem 0 rgba(43, 21, 53, 0.28);\n            }\n\n            .lp-container .section-28__figure {\n                aspect-ratio: 1250 / 650;\n                border-radius: 1.2rem;\n            }\n\n            /* Balão de fala sobre a área livre da arte */\n            .lp-container .section-28__content {\n                position: relative;\n                z-index: 2;\n                overflow: visible;\n                border: 0.2rem solid var(--toon-ink);\n                border-radius: 1.6rem 1.6rem 1.6rem 0.55rem;\n                color: var(--toon-ink);\n                background:\n                    radial-gradient(circle at 92% 16%, rgba(247, 43, 136, 0.13) 0 0.22rem, transparent 0.24rem) 0 0 / 0.9rem 0.9rem,\n                    var(--toon-paper);\n                box-shadow: 0.5rem 0.5rem 0 var(--toon-ink);\n            }\n\n            .lp-container .section-28__content::before {\n                content: \"\";\n                width: 1.35rem;\n                height: 1.35rem;\n                position: absolute;\n                left: 1.5rem;\n                bottom: -0.82rem;\n                z-index: -1;\n                border-right: 0.2rem solid var(--toon-ink);\n                border-bottom: 0.2rem solid var(--toon-ink);\n                background: var(--toon-paper);\n                transform: rotate(45deg);\n            }\n\n            .lp-container .section-28__content::after {\n                content: \"✦\";\n                position: absolute;\n                top: 0.75rem;\n                right: 1rem;\n                color: var(--toon-pink);\n                font-size: 1.35rem;\n                line-height: 1;\n                transform: rotate(12deg);\n            }\n\n            .lp-container .section-28__panel--care .section-28__content {\n                border-radius: 1.6rem 1.6rem 0.55rem 1.6rem;\n            }\n\n            .lp-container .section-28__panel--care .section-28__content::before {\n                right: 1.5rem;\n                left: auto;\n            }\n\n            .lp-container .section-28__title {\n                padding-right: 1.75rem;\n                color: var(--toon-ink);\n                font-family: \"Arial Rounded MT Bold\", \"Trebuchet MS\", Arial, sans-serif;\n                font-weight: 900;\n                line-height: 1.05;\n                letter-spacing: -0.035em;\n            }\n\n            .lp-container .section-28__rule {\n                width: 4.5rem;\n                height: 0.6rem;\n                border: 0.125rem solid var(--toon-ink);\n                border-radius: 999px;\n                background: repeating-linear-gradient(135deg,\n                        var(--toon-pink) 0 0.55rem,\n                        var(--toon-lime) 0.55rem 1.1rem);\n                box-shadow: 0.15rem 0.15rem 0 var(--toon-ink);\n                transform: rotate(-2deg);\n            }\n\n            .lp-container .section-28__copy {\n                color: #5d3f62;\n                font-weight: 600;\n                line-height: 1.6;\n            }\n\n            /* Abas como adesivos/botões de quadrinhos */\n            .lp-container .section-28__tabs {\n                gap: 0.85rem;\n            }\n\n            .lp-container .section-28__tab {\n                min-height: 3.75rem;\n                border: 0.18rem solid var(--toon-ink);\n                border-radius: 1rem;\n                color: var(--toon-ink);\n                background: var(--toon-paper);\n                box-shadow: 0.28rem 0.28rem 0 var(--toon-ink);\n                transform: translate(0, 0);\n                transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease;\n            }\n\n            .lp-container .section-28__tab:hover {\n                background: #fff3ad;\n                transform: translate(-0.08rem, -0.08rem) rotate(-0.4deg);\n                box-shadow: 0.38rem 0.38rem 0 var(--toon-ink);\n            }\n\n            .lp-container .section-28__tab-text {\n                color: currentColor;\n                font-family: \"Arial Rounded MT Bold\", \"Trebuchet MS\", Arial, sans-serif;\n                font-weight: 900;\n            }\n\n            .lp-container .section-28__control:focus-visible+.section-28__tab {\n                outline: 0.22rem solid var(--toon-cyan);\n                outline-offset: 0.25rem;\n            }\n\n            .lp-container .section-28:has(.section-28__control--protection:checked) .section-28__tab--protection,\n            .lp-container .section-28:has(.section-28__control--care:checked) .section-28__tab--care,\n            .lp-container .section-28:has(.section-28__control--fragrance:checked) .section-28__tab--fragrance,\n            .lp-container .section-28:has(.section-28__control--application:checked) .section-28__tab--application {\n                border-color: var(--toon-ink);\n                color: var(--toon-ink);\n                background: var(--toon-lime);\n                box-shadow: 0.16rem 0.16rem 0 var(--toon-ink);\n                transform: translate(0.12rem, 0.12rem) rotate(-0.5deg);\n            }\n\n            .lp-container .section-28__dots {\n                gap: 0.55rem;\n            }\n\n            .lp-container .section-28__dot {\n                width: 1.7rem;\n                height: 0.55rem;\n                flex-basis: 1.7rem;\n                border: 0.12rem solid var(--toon-ink);\n                border-radius: 999px;\n                background: var(--toon-paper);\n            }\n\n            .lp-container .section-28:has(.section-28__control--protection:checked) .section-28__dot--protection,\n            .lp-container .section-28:has(.section-28__control--care:checked) .section-28__dot--care,\n            .lp-container .section-28:has(.section-28__control--fragrance:checked) .section-28__dot--fragrance,\n            .lp-container .section-28:has(.section-28__control--application:checked) .section-28__dot--application {\n                background: var(--toon-pink);\n                transform: rotate(-3deg) scaleX(1.08);\n            }\n\n            /* Aviso e FAQ no mesmo universo visual */\n            .lp-container .pdp>p[style] {\n                width: min(100% - 2rem, 72rem);\n                margin: 0 auto;\n                padding: 2rem 1rem !important;\n                color: var(--toon-ink) !important;\n                font-family: \"Trebuchet MS\", Arial, sans-serif;\n                font-size: clamp(0.72rem, 1.5vw, 0.88rem) !important;\n                font-weight: 900;\n                letter-spacing: 0.09em;\n                text-transform: uppercase;\n            }\n\n            .lp-container #faq-section {\n                width: min(100% - 2rem, 72rem);\n                margin: 0 auto 2.5rem;\n                padding: clamp(1rem, 3vw, 2rem);\n                border: 0.2rem solid var(--toon-ink);\n                border-radius: 1.75rem;\n                background:\n                    radial-gradient(circle, rgba(247, 43, 136, 0.11) 0 2px, transparent 2.5px) 0 0 / 20px 20px,\n                    var(--toon-cream);\n                box-shadow: 0.55rem 0.55rem 0 var(--toon-ink);\n            }\n\n            .lp-container #faq-section__header {\n                margin-bottom: 1.25rem;\n            }\n\n            .lp-container #faq-section__title {\n                color: var(--toon-ink);\n                font-family: \"Arial Rounded MT Bold\", \"Trebuchet MS\", Arial, sans-serif;\n                font-size: clamp(1.75rem, 4vw, 2.6rem);\n                font-weight: 900;\n                line-height: 1.05;\n                letter-spacing: -0.04em;\n                text-shadow: 0.12rem 0.12rem 0 rgba(247, 43, 136, 0.2);\n            }\n\n            .lp-container #faq-section__list {\n                display: grid;\n                gap: 0.85rem;\n            }\n\n            .lp-container #faq-section__item {\n                overflow: hidden;\n                border: 0.16rem solid var(--toon-ink);\n                border-radius: 1rem;\n                background: var(--toon-paper);\n                box-shadow: 0.25rem 0.25rem 0 var(--toon-ink);\n                transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease;\n            }\n\n            .lp-container #faq-section__item:nth-child(odd) {\n                transform: rotate(-0.15deg);\n            }\n\n            .lp-container #faq-section__item:nth-child(even) {\n                transform: rotate(0.15deg);\n            }\n\n            .lp-container #faq-section__item:has(details[open]) {\n                background: #fff3ad;\n                box-shadow: 0.38rem 0.38rem 0 var(--toon-ink);\n                transform: translate(-0.08rem, -0.08rem) rotate(0);\n            }\n\n            .lp-container #faq-section__summary {\n                padding: 1rem 1.125rem;\n                color: var(--toon-ink);\n                cursor: pointer;\n            }\n\n            .lp-container #faq-section__q-text {\n                min-width: 0;\n                color: inherit;\n                font-family: \"Trebuchet MS\", Arial, sans-serif;\n                font-size: clamp(0.95rem, 2vw, 1.08rem);\n                font-weight: 900;\n                line-height: 1.4;\n                overflow-wrap: anywhere;\n            }\n\n            .lp-container #faq-section__icon {\n                border: 0.12rem solid var(--toon-ink);\n                border-radius: 50%;\n                background: var(--toon-lime);\n            }\n\n            .lp-container #faq-section__a-inner {\n                padding: 0 1.125rem 1.125rem;\n            }\n\n            .lp-container #faq-section__a-text {\n                color: #5d3f62;\n                font-weight: 600;\n                line-height: 1.65;\n            }\n\n            @media (min-width: 768px) {\n                .lp-container .section-28__figure {\n                    width: 100%;\n                    height: auto;\n                    min-height: 0;\n                    max-height: none;\n                    aspect-ratio: 1250 / 650;\n                }\n\n                .lp-container .section-28__figure picture,\n                .lp-container .section-28__image {\n                    width: 100%;\n                    height: 100%;\n                }\n\n                .lp-container .section-28__content {\n                    position: absolute;\n                    margin: 0;\n                }\n            }\n\n            @media (max-width: 767px) {\n                .lp-container .video-header {\n                    --badge-size: 6.5rem;\n                    padding-inline: 0.75rem;\n                }\n\n                .lp-container .video-header__banner {\n                    border-width: 0.15rem;\n                    border-radius: 0 0 1.15rem 1.15rem;\n                    box-shadow: 0.32rem 0.32rem 0 var(--toon-ink);\n                }\n\n                .lp-container .section-28 {\n                    padding-inline: 0.75rem;\n                }\n\n                .lp-container .section-28__inner {\n                    padding: 0.65rem;\n                    border-width: 0.16rem;\n                    border-radius: 1.35rem;\n                    box-shadow: 0.35rem 0.35rem 0 var(--toon-ink);\n                }\n\n                .lp-container .section-28__viewport {\n                    overflow: visible;\n                    border-width: 0.16rem;\n                    border-radius: 1.1rem;\n                }\n\n                .lp-container .section-28__figure {\n                    border-radius: 0.9rem 0.9rem 0 0;\n                }\n\n                .lp-container .section-28__content {\n                    width: calc(100% - 1rem);\n                    align-self: center;\n                    margin: -0.8rem auto 0;\n                    border-width: 0.16rem;\n                    border-radius: 1.25rem 1.25rem 1.25rem 0.45rem;\n                    box-shadow: 0.32rem 0.32rem 0 var(--toon-ink);\n                }\n\n                .lp-container .section-28__panel--care .section-28__content {\n                    border-radius: 1.25rem 1.25rem 0.45rem 1.25rem;\n                }\n\n                .lp-container #faq-section {\n                    width: calc(100% - 1.5rem);\n                    min-width: 0;\n                    max-width: calc(100% - 1.5rem);\n                    border-width: 0.16rem;\n                    border-radius: 1.35rem;\n                    box-shadow: 0.35rem 0.35rem 0 var(--toon-ink);\n                }\n            }\n\n            @media (max-width: 420px) {\n                .lp-container .section-28__tabs {\n                    grid-template-columns: 1fr;\n                }\n            }\n\n            @media (prefers-reduced-motion: reduce) {\n\n                .lp-container .section-28__panel,\n                .lp-container .section-28__tab,\n                .lp-container #faq-section__item {\n                    transition: none;\n                }\n            }\n        </style>\n\n\n\n        <section id=\"faq-section\" aria-labelledby=\"faq-section__title\">\n            <div id=\"faq-section__header\">\n                <h2 id=\"faq-section__title\">Dúvidas Frequentes</h2>\n            </div>\n            <ul id=\"faq-section__list\" role=\"list\"> <!-- Cole aqui as perguntas e respostas -->\n                <li id=\"faq-section__item\">\n                    <details id=\"faq-section__details\">\n                        <summary id=\"faq-section__summary\">\n                            <h3 id=\"faq-section__q-text\"> Para quais tipos de cabelo o Creme de Tratamento Salon Line\n                                Cachos dos Sonhos Multy Pink Lemonade 3 em 1 é indicado? </h3>\n                            <span id=\"faq-section__icon\" aria-hidden=\"true\"></span>\n                        </summary>\n                        <div id=\"faq-section__a-inner\">\n                            <p id=\"faq-section__a-text\"> É indicado para cabelos ondulados, cacheados e crespos,\n                                especialmente fios ressecados, sem definição e com pouco brilho. </p>\n                        </div>\n                    </details>\n                </li>\n                <!-------------------------->\n\n                <!-- Cole aqui as perguntas e respostas -->\n                <li id=\"faq-section__item\">\n                    <details id=\"faq-section__details\">\n                        <summary id=\"faq-section__summary\">\n                            <h3 id=\"faq-section__q-text\"> Como usar o produto para fazer uma hidratação profunda? </h3>\n                            <span id=\"faq-section__icon\" aria-hidden=\"true\"></span>\n                        </summary>\n                        <div id=\"faq-section__a-inner\">\n                            <p id=\"faq-section__a-text\"> Como creme de tratamento, deve ser aplicado nos fios, agir por\n                                5 minutos e ser enxaguado para proporcionar hidratação intensa. </p>\n                        </div>\n                    </details>\n                </li>\n                <!-------------------------->\n\n                <!-- Cole aqui as perguntas e respostas -->\n                <li id=\"faq-section__item\">\n                    <details id=\"faq-section__details\">\n                        <summary id=\"faq-section__summary\">\n                            <h3 id=\"faq-section__q-text\"> Quanto tempo o creme precisa agir como super condicionador?\n                            </h3>\n                            <span id=\"faq-section__icon\" aria-hidden=\"true\"></span>\n                        </summary>\n                        <div id=\"faq-section__a-inner\">\n                            <p id=\"faq-section__a-text\"> A ação leva apenas 2 minutos. Após a aplicação, basta enxaguar\n                                bem para obter fios mais macios e fáceis de desembaraçar. </p>\n                        </div>\n                    </details>\n                </li>\n                <!-------------------------->\n\n                <!-- Cole aqui as perguntas e respostas -->\n                <li id=\"faq-section__item\">\n                    <details id=\"faq-section__details\">\n                        <summary id=\"faq-section__summary\">\n                            <h3 id=\"faq-section__q-text\"> O Pink Lemonade pode ser utilizado como creme para pentear sem\n                                enxágue? </h3>\n                            <span id=\"faq-section__icon\" aria-hidden=\"true\"></span>\n                        </summary>\n                        <div id=\"faq-section__a-inner\">\n                            <p id=\"faq-section__a-text\"> Sim. Na finalização, ajuda a desembaraçar os fios com leveza,\n                                deixando os cabelos soltinhos, definidos e perfumados. </p>\n                        </div>\n                    </details>\n                </li>\n                <!-------------------------->\n\n                <!-- Cole aqui as perguntas e respostas -->\n                <li id=\"faq-section__item\">\n                    <details id=\"faq-section__details\">\n                        <summary id=\"faq-section__summary\">\n                            <h3 id=\"faq-section__q-text\"> Como o tratamento ajuda a controlar o frizz e melhorar a\n                                definição dos cachos? </h3>\n                            <span id=\"faq-section__icon\" aria-hidden=\"true\"></span>\n                        </summary>\n                        <div id=\"faq-section__a-inner\">\n                            <p id=\"faq-section__a-text\"> Sua fórmula multifuncional oferece hidratação profunda, ajuda a\n                                controlar o frizz e proporciona definição com brilho radiante. </p>\n                        </div>\n                    </details>\n                </li>\n                <!-------------------------->\n            </ul>\n        </section>\n    </article>\n</div>",
