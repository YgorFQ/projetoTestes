{
  "name": "senkolib-functions",
  "private": true,
  "version": "1.0.0",
  "description": "Backend Firebase do SenkoLib",
  "main": "src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/content.js && node --check src/github-export.js",
    "migrate:legacy": "node scripts/import-legacy.js",
    "serve": "firebase emulators:start --only auth,firestore,database,storage,functions,hosting",
    "deploy": "firebase deploy --only firestore,database,storage,functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@firebase/app": "0.16.0",
    "@firebase/app-compat": "0.5.16",
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2"
  }
}
