{
  "name": "senkolib",
  "private": true,
  "version": "1.0.0",
  "description": "SenkoLib com infraestrutura Firebase",
  "scripts": {
    "firebase:login": "firebase login",
    "firebase:use": "firebase use",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,database",
    "firebase:deploy:hosting": "firebase deploy --only hosting",
    "migration:build": "node tools/build-legacy-snapshot.js",
    "backup:build-static": "node tools/build-static-backup.js",
    "test:asset-versioning": "node tests/asset-versioning.test.js",
    "test:static-backup": "node tests/static-backup-builder.test.js",
    "test:firebase-health": "node tests/firebase-service-health.test.js",
    "test:firestore-rules": "firebase emulators:exec --only firestore --project senkolib-rules-test \"node tests/firestore-client-writes.test.js\"",
    "test:database-rules": "firebase emulators:exec --only database --project senkolib-database-rules-test \"node tests/database-member-management.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.17.0",
    "firebase-tools": "15.25.0"
  }
}
