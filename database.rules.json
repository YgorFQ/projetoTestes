{
  "rules": {
    ".read": false,
    ".write": false,
    "presenceAccess": {
      "$workspaceId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (root.child('memberManagers').child($workspaceId).child(auth.uid).val() === 'owner' || (root.child('memberManagers').child($workspaceId).child(auth.uid).val() === 'admin' && !root.child('memberManagers').child($workspaceId).child($uid).exists()))",
          ".validate": "newData.val() === null || newData.val() === true"
        }
      }
    },
    "memberManagers": {
      "$workspaceId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && root.child('memberManagers').child($workspaceId).child(auth.uid).val() === 'owner' && auth.uid !== $uid",
          ".validate": "newData.val() === null || newData.val() === 'owner' || newData.val() === 'admin'"
        }
      }
    },
    "presence": {
      "$workspaceId": {
        "$resourceType": {
          "$resourceId": {
            ".read": "auth != null && root.child('presenceAccess').child($workspaceId).child(auth.uid).val() === true",
            "$uid": {
              "$sessionId": {
                ".write": "auth != null && auth.uid === $uid && root.child('presenceAccess').child($workspaceId).child(auth.uid).val() === true",
                ".validate": "newData.val() === null || (newData.hasChildren(['displayName', 'joinedAt']) && newData.child('displayName').isString())"
              }
            }
          }
        }
      }
    }
  }
}
